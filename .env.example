# ─── Constructor Express — Variables de Entorno ───────────────────────────────
# Copia este archivo a .env.production y rellena los valores antes del deploy.

# ── Seguridad (OBLIGATORIO en producción) ────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-segura-de-50-chars-minimo
DEBUG=False
ALLOWED_HOSTS=tudominio.cl,www.tudominio.cl

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=constructor_express_db
POSTGRES_USER=ce_user
POSTGRES_PASSWORD=cambia-esto

# ── Email transaccional (SendGrid) ───────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Constructor Express <noreply@tudominio.cl>

# ── Celery / Redis ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0

# ── Mercado Pago ─────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu-webhook-secret-hmac

# ── WhatsApp / Twilio ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Facturación SII (OpenFactura) ────────────────────────────────────────────
SII_PROVIDER_API_KEY=tu-api-key-openfactura
SII_RUT_EMISOR=12345678-9
SII_ENV=sandbox

# ── Observabilidad (opcional) ─────────────────────────────────────────────────
# SENTRY_DSN=https://tu-dsn@o12345.ingest.sentry.io/67890
# SENTRY_ENV=production

# ── Suscripción Pro: estados válidos ──────────────────────────────────────────
# active    → suscripción vigente (is_pro() = True)
# pending   → checkout iniciado, sin confirmar pago
# cancelled → cancelada (is_pro() = False inmediatamente si next_billing_date < hoy)
# past_due  → pago fallido
